{
    "elements": [

        
        {
        "type": "Image",
        "image": "data:image/png;base64,  ",
        "width": "250px"
        },
        {
            "type": "Label",
            "caption": "Cloud-Splitter Konfiguration",
            "bold": true
        },
        {    
            "type": "ValidationTextBox",
            "name": "Username",
            "caption": "Benutzername"
        },

        {
            "type": "PasswordTextBox",
            "name": "Password",
            "caption": "Passwort"
        },
        {
            "type": "Button",
            "caption": "Authentifizieren",
            "onClick": "BWS_FetchAccessToken($id);"
        },

        {
            "type": "PopupAlert",
            "name": "pop",
            "visible": false,
            "popup": {
                "caption": "Automatische WebSocket Konfiguration",
                "closeCaption": "Dialog schließen",
                "items": [
                    {
                    "type": "Label",
                    "caption": "Die Authentifizierung war erflogreich, um die IO-Instanz (WebSocket) zu konfigurieren und die Verbindung zu öffnen, bitte den Button 'WebSocket konfigurieren' drücken"
                    },
                    {
                    "type": "Button",
                    "caption": "WebSocket konfigurieren",
                    "onClick": "BWS_SetupWebSocketConnection($id);"
                }
                ]
            }
        }
       
                ],
    "actions": [
        
        { "type": "Label", "caption": "Zur Konfiguration und zum verbinden des WebSockets, nachfolgenden Button drücken"},
        {
            "type": "Button",
            "caption": "WebSocket konfigurieren",
            "onClick": "BWS_SetupWebSocketConnection($id);"
        }
                ],

    "status": [

        { "code": 104, "icon": "inactive", "caption": "Cloud Splitter nicht verbunden!" },
        { "code": 102, "icon": "active", "caption": "Verbindung hergestellt" },
        { "code": 201, "icon": "error", "caption": "Benutzername existiert nicht!" },
        { "code": 202, "icon": "error", "caption": "Benutzername oder Passwort falsch!" },
        { "code": 203, "icon": "error", "caption": "Ungültiger AccessToken!" },
        { "code": 204, "icon": "error", "caption": "Zuviele Anfragen, versuche es in 10 Minuten erneut!" }

    ]

